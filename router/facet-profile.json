  "$comment": "人工审阅 useWhen/structure 的拍法画像。hard 排除明确冲突，soft 只影响排序；metadata 字段仅供宿主说明。",
  "facets": {
    "styleMode": {
      "values": [
        "live",
        "animated",
        null
      ],
      "ask": "要实拍质感还是动画/风格化？"
    },
    "shotPlan": {
      "values": [
        "single",
        "multi",
        null
      ],
      "ask": "一镜到底，还是切成多个镜头？"
    },
    "hasDialogue": {
      "values": [
        true,
        false,
        null
      ],
      "ask": "片子里需要有人声台词吗？（台词不自动要求口型同步）"
    },
    "hasReference": {
      "values": [
        true,
        false,
        null
      ],
      "ask": "你会提供参考图（人物/产品/分镜图）吗？"
    },
    "hasMusicSync": {
      "values": [
        true,
        false
      ],
      "ask": "需要卡音乐节拍吗？"
    },
    "textOnScreen": {
      "values": [
        true,
        false
      ],
      "ask": "画面里要出现可读文字或字幕吗？"
    },
    "durationSec": {
      "values": [
        "number|null"
      ],
      "ask": "成片总时长是多少秒？"
    },
    "subjects": {
      "values": [
        "person",
        "animal",
        "vehicle",
        "product",
        "place",
        "abstract"
      ],
      "ask": "主角是人、动物、载具、产品、地点，还是抽象概念？"
    }
  },
